<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>LILLAH FOUNDATION - President Voting</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Georgia, serif;
            background: #f5f0e4;
            color: #123f35;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .page {
            width: 100%;
            min-height: 100vh;
            padding: 50px 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .card {
            max-width: 850px;
            width: 100%;
        }

        .logo {
            width: 120px;
            height: 120px;
            object-fit: contain;
            margin-bottom: 15px;
        }

        h1 {
            font-size: 52px;
            letter-spacing: 3px;
            margin: 10px 0;
        }

        .line {
            width: 180px;
            height: 3px;
            background: #c6a15b;
            margin: 25px auto;
        }

        h2 {
            font-size: 38px;
            letter-spacing: 2px;
            margin: 10px 0 40px;
        }

        p {
            font-family: Arial, sans-serif;
            font-size: 19px;
            margin: 15px;
        }

        .access-box {
            margin: 35px auto 15px;
            max-width: 570px;
        }

        input {
            width: 100%;
            padding: 20px;
            font-size: 17px;
            border: 2px solid #ccc;
            border-radius: 12px;
            outline: none;
        }

        button {
            width: 100%;
            margin-top: 18px;
            padding: 18px;
            font-size: 20px;
            border: none;
            border-radius: 12px;
            background: #123f35;
            color: white;
            cursor: pointer;
        }

        button:hover {
            background: #0b3028;
        }

        .results-link {
            display: inline-block;
            margin-top: 20px;
            padding: 12px 25px;
            color: #123f35;
            border: 2px solid #123f35;
            border-radius: 10px;
            text-decoration: none;
            font-family: Arial, sans-serif;
            font-size: 16px;
        }

        .results-link:hover {
            background: #123f35;
            color: white;
        }

        @media (max-width: 700px) {
            h1 {
                font-size: 35px;
            }

            h2 {
                font-size: 27px;
            }
        }
    </style>
</head>

<body>

<div class="page">
    <div class="card">

        <img
            src="{{ url_for('static', filename='logo.jpeg') }}"
            class="logo"
            alt="Lillah Foundation Logo"
        >

        <h1>LILLAH FOUNDATION</h1>

        <div class="line"></div>

        <h2>PRESIDENT VOTING</h2>

        <p>Welcome to the President Voting Portal</p>

        <p>Please enter your access code to continue.</p>

        <div class="access-box">

            <form action="/login" method="POST">

                <input
                    type="text"
                    name="code"
                    placeholder="Enter your access code"
                    required
                >

                <button type="submit">
                    Continue →
                </button>

            </form>

            <a href="/results" class="results-link">
                View Results
            </a>

        </div>

    </div>
</div>

</body>
</html>
